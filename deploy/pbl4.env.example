# Chi mo ta ten bien; setup-database.sh se tao gia tri bi mat rieng tren AWS.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5000
ConnectionStrings__DefaultConnection="Server=127.0.0.1,1433;Database=PBL4;User ID=pbl4_backend;Password=REPLACE_ON_SERVER;Encrypt=True;TrustServerCertificate=True;Connect Timeout=5"
Jwt__SigningKey=REPLACE_WITH_RANDOM_SECRET_ON_SERVER

# Neu can frontend khac origin, bo comment va thay bang dung URL HTTPS.
